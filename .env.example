# ── Base de données PostgreSQL (Neon / Vercel Postgres / Supabase) ──
# Obtenir gratuitement sur https://neon.tech ou https://vercel.com/storage/postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──
NEXTAUTH_URL="https://votre-domaine.vercel.app"
NEXTAUTH_SECRET="générer avec: openssl rand -base64 32"

# ── OAuth (optionnel) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# ── Stripe ──
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."

# ── IA (optionnel) ──
# Together AI gratuit : https://api.together.xyz
TOGETHER_API_KEY=""
# Ollama local
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# ── App ──
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"
