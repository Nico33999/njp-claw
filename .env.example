# ── Base de données PostgreSQL (Neon / Vercel Postgres / Supabase) ──
# Obtenir gratuitement sur https://neon.tech ou https://vercel.com/storage/postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──
NEXTAUTH_URL="https://votre-domaine.vercel.app"
NEXTAUTH_SECRET="générer avec: openssl rand -base64 32"

# ── OAuth (optionnel) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# ── Stripe ──
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."

# ── IA — au moins une clé requise ──
# OPTION 1 (recommandé) : Groq — gratuit, ultra rapide, Llama 3.1
# Inscription gratuite sur https://console.groq.com
GROQ_API_KEY="gsk_..."

# OPTION 2 : Together AI — gratuit (1$ de crédit)
# https://api.together.xyz
TOGETHER_API_KEY=""

# OPTION 3 : Ollama local (développement seulement)
OLLAMA_URL=""
OLLAMA_MODEL="llama3.1"

# ── App ──
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"
